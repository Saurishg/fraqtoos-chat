.env
tunnel.log
tunnel_*.log
# logrotate suffixes — `tunnel_*.log` does NOT match `tunnel_x.log.1` or
# `tunnel_x.log.2.gz`, so rotated tunnel logs were sweepable by `git add -A`.
# They carry live trycloudflare hostnames and this repo is PUBLIC.
tunnel_*.log.*
__pycache__/
*.pyc

# user data — never commit
conversations/
memory.json

# local agent config
.claude/

# ruflo agent metadata + runtime caches (added 2026-05-07)
.claude-flow/
claude-flow.config.json
conv_embeddings.json
vault_index.json

# vector store of conversation embeddings — private user data
ruvector.db
